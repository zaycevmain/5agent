[Unit]
Description=5agent monitoring server (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
# Поменяй на реальный путь до папки server
WorkingDirectory=/opt/5agent/server
# venv должен существовать: создай его один раз (см. run.sh)
ExecStart=/opt/5agent/server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
# Замени на существующего непривилегированного пользователя
User=5agent

[Install]
WantedBy=multi-user.target
